# Rename to secrets.py on the Presto.
WIFI_SSID = "your_ssid"
WIFI_PASSWORD = "your_password"

# --- Flight tracker (optional) -----------------------------------------------
# Centre the radar on a fixed point instead of an IP lookup.
# LATITUDE = 12.3456
# LONGITUDE = -1.2345
# LOCATION_NAME = "Home"

# An OpenSky API client raises the daily allowance from 400 to 4000 credits,
# which is what buys the 30 second refresh. https://opensky-network.org/my-opensky
# OPENSKY_CLIENT_ID = "your-client-id"
# OPENSKY_CLIENT_SECRET = "your-client-secret"
